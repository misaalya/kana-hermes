--- a/qwen_tts_thread.c
+++ b/qwen_tts_thread.c
@@ -1,3 +1,7 @@
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE /* pthread_setaffinity_np */
+#endif
+
 /*
  * qwen_tts_thread.c - Cross-OS parallel-for (PLAN 21.2)
  *
@@ -130,6 +134,21 @@ void qwen_threadpool_start(int n_threads) {
         created++;
     }
     P.nworkers = created;
+#if defined(__linux__)
+    /* Kana experiment: optional per-worker core pinning (QWEN_PIN_AFFINITY=1).
+     * On vCPU-scattered VMs the scheduler migrates pool threads across CCDs,
+     * evicting the weights the previous pass pulled into L3. Round-robin
+     * pinning keeps each worker warm on one core. Best-effort only. */
+    if (created > 0 && getenv("QWEN_PIN_AFFINITY")) {
+        int ncpu = (int)sysconf(_SC_NPROCESSORS_ONLN);
+        for (int i = 0; i < created; i++) {
+            cpu_set_t set;
+            CPU_ZERO(&set);
+            CPU_SET(i % (ncpu > 0 ? ncpu : 1), &set);
+            pthread_setaffinity_np(P.threads[i], sizeof(set), &set);
+        }
+    }
+#endif
     if (created == 0) { free(P.threads); P.threads = NULL; }
 }
 
