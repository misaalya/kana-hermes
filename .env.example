# Single authoritative data directory (config.json, appstate.db, activities.db, jwt-secret, voices/). Precedence:
# KANA_DATA_DIR, otherwise ~/.kana. On the first start after an upgrade, data from
# the earlier roots ($XDG_DATA_HOME/kana, ~/.local/share/kana, ./data) is moved into it.
# KANA_DATA_DIR=/var/lib/kana

# Optional overrides (generated automatically when unset):
# KANA_JWT_SECRET=64-hex-chars
# AUTH_COOKIE_SECURE=true   # recommended behind nginx if X-Forwarded-Proto is not forwarded
