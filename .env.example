# Set a bootstrap access password to enable authentication for Kana.
# Required when deploying to a VPS or any shared machine. Once logged in you
# can change the password from the app; the changed password is stored as a
# bcrypt hash in the Kana data directory (see KANA_DATA_DIR below) and then
# takes precedence over this value.
# Sessions are stateless HS256 JWT cookies signed with <data dir>/jwt-secret
# (override with KANA_JWT_SECRET). If empty, Kana starts without login —
# in production that requires KANA_ALLOW_NO_AUTH=1 and is surfaced as
# insecureNoAuth by /api/auth/status.
KANA_ACCESS_PASSWORD=

# Single authoritative data directory (auth.json, jwt-secret). Precedence:
# KANA_DATA_DIR → $XDG_DATA_HOME/kana → ~/.local/share/kana. Existing files
# under ./data or ~/.kana are migrated automatically on first use.
# KANA_DATA_DIR=/var/lib/kana

# Shared secret for reverse-proxy trust. When set, local-only routes accept
# requests presenting `X-Kana-Trusted-Proxy: <this value>` (nginx config:
# proxy_set_header X-Kana-Trusted-Proxy "<the same value>";) and ignore
# hostname-based loopback checks. When unset, the header is ignored and only
# direct loopback Host/Origin pairs are trusted. Never blank it on the proxy
# unless you also blank it here.
# KANA_TRUSTED_PROXY_SECRET=

# Optional overrides (generated automatically when unset):
# KANA_JWT_SECRET=64-hex-chars
# AUTH_COOKIE_SECURE=true   # recommended behind nginx if X-Forwarded-Proto is not forwarded
