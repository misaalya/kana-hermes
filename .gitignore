# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
# Playwright writes its HTML report, its blob report, and every trace,
# screenshot, and running server's data root under test-results.
/coverage
/playwright-report/
/blob-report/
/test-results/

# next.js
# One pattern for the whole dist-dir family: KANA_NEXT_DIST_DIR can name any
# of them, and an unignored one is also read by the Tailwind class scan.
/.next*/
/out/
/.npm-package/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files. Keep only the credential-free template in Git.
.env*
!.env.example

# vercel
.vercel

# Python service runtime artifacts (the service source itself is tracked)
/services/**/.venv/
/services/**/.pytest_cache/

# typescript
*.tsbuildinfo
next-env.d.ts
reference/

# Local reference checkouts (read-only study material)
/auth-reference/
/data/

# Adjacent standalone projects maintained in their own repositories
/web/
/showcase/

# Local audit/debug artifacts. These are this machine's tool state, not the
# project: Playwright MCP traces, the agent harness's own directories, the
# code graph, the stage-scene experiments, and Freebuff's project id. They must
# never be pushed from ANY checkout, so they are ignored here rather than in
# .git/info/exclude, which stays on one machine.
.playwright-mcp/
/.local/
/.freebuff/
/.codegraph/
/.hermes/
/.omo/
*.log
/*.png
/snapshot.txt

# Local release evidence and the local remediation plan. The recorders create
# the evidence files on first use; none of it is part of the repository.
/acceptance/
/dogfood/
/PLAN.md

# Server-side activity store (SQLite)
.kana/

# Generated npm CLI distribution (cli/package.json is the publication manifest)
/cli/.npm-package/
/cli/bin/
/cli/config/
/cli/shared/
/cli/docs/
/cli/README.md
/cli/CHANGELOG.md
/cli/PLAN.md
/cli/LICENSE
/*.tgz
/cli/*.tgz

# Local study checkouts of other projects (never committed)
/.study/
