# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.next-e2e/
/out/
/.npm-package/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files. Keep only the credential-free template in Git.
.env*
!.env.example

# vercel
.vercel

# Python service (not part of the Next.js app)
/services/

# typescript
*.tsbuildinfo
next-env.d.ts
reference/

# Local reference checkouts (read-only study material)
/auth-reference/
/data/

# Adjacent standalone projects maintained in their own repositories
/web/
/showcase/

# Local audit/debug artifacts
.playwright-mcp/
/.hermes/
/.omo/
/*.png
/snapshot.txt

# Server-side activity store (SQLite)
.kana/
